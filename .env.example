# App Suite Environment Variables

# Basic App Configuration
NODE_ENV=development
PORT=3000
CALENDAR_API_PORT=3001
VITE_SITE_URL=https://www.app-suite.io

# Google Calendar API Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Google Calendar Access Tokens (obtained after OAuth flow)
GOOGLE_ACCESS_TOKEN=your_access_token_here
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Email Service Configuration
EMAIL_SERVICE=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxx
ADMIN_EMAIL=jason@jaydus.ai

# AI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxx

# Database - NOW USES NEON
DATABASE_URL=your_neon_database_url_here
POSTGRES_URL=your_neon_database_url_here

# Security
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Payment Processing
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Email Services (in addition to Resend)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=notifications@app-suite.io

# File Storage (optional - uses local storage if not configured)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your_s3_bucket_name_here
AWS_BUCKET_PUBLIC=false

# Calendar Business Settings
DEFAULT_TIMEZONE=America/New_York
DEFAULT_MEETING_DURATION=30
BUFFER_TIME_MINUTES=15
MAX_ADVANCE_BOOKING_DAYS=60
MIN_ADVANCE_HOURS=2

# Feature Flags
ENABLE_CALENDAR_BOOKING=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_CHATBOT_INTEGRATION=true