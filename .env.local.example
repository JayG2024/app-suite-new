# App Suite Environment Variables - Template
# Copy this file to .env.local and replace placeholder values

# ============================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# ============================================
# REQUIRED: Replace with your actual Neon database connection string
# Get from: https://neon.tech/ dashboard
# Format: postgresql://username:password@host/database
DATABASE_URL=your_neon_database_url_here

# ============================================
# AI SERVICE API KEYS
# ============================================
# REQUIRED: Claude Sonnet 4 API Key for main AI features
# Get from: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# OPTIONAL: OpenAI API Key (for backup AI features)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# EMAIL & COMMUNICATION SERVICES
# ============================================
# REQUIRED: Resend API Key for transactional emails
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email service configuration
EMAIL_SERVICE=resend
NEWSLETTER_SERVICE=email

# ============================================
# APPLICATION SETTINGS
# ============================================
# Production environment settings
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://www.app-suite.io
VITE_SITE_URL=https://www.app-suite.io

# Admin settings
ADMIN_EMAIL=jason@jaydus.ai

# ============================================
# SECURITY & FEATURES
# ============================================
# Enable database features
ENABLE_DATABASE=true
ENABLE_ADMIN_PANEL=true
ENABLE_ANALYTICS=true

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file to .env.local
# 2. Replace all placeholder values with your actual API keys
# 3. Set up your Neon database and add the connection string
# 4. Get API keys from the URLs provided above
# 5. Run: node setup-database.js to initialize database tables